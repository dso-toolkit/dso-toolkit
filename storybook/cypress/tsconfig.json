{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "types": [
      "cypress",
      "cypress-axe",
      "cypress-real-events",
      "@simonsmith/cypress-image-snapshot/types",
      "dso-toolkit"
    ],
    "baseUrl": ".",
    "paths": {
      "dso-toolkit/src/*": ["../../packages/dso-toolkit/src/*"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"]
}
