{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "types": [
      "cypress",
      "cypress-axe",
      "cypress-real-events",
      "@simonsmith/cypress-image-snapshot/types",
      "@dso-toolkit/core"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"]
}
